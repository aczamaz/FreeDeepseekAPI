# FreeDeepseekAPI — example configuration.
# All variables are optional; the defaults shown below are what the code uses.
# Copy this file to .env and override as needed (a real .env is gitignored).

# ── HTTP server ──
PORT=9655
# Loopback-only by default. Use 0.0.0.0 only when remote access is intentional.
HOST=127.0.0.1
# Optional bearer token required by every non-health endpoint. Strongly
# recommended whenever HOST is not a loopback address.
# PROXY_API_KEY=replace-with-a-long-random-value
# Read the bearer token from a mounted secret instead of the environment.
# PROXY_API_KEY_FILE=/run/secrets/proxy-api-key
# Fail startup when neither key source is set (enabled by Containerfile).
REQUIRE_PROXY_API_KEY=0
# Browser requests are accepted from loopback origins. Add exact remote UI
# origins as a comma-separated allowlist when needed.
# PROXY_CORS_ORIGINS=https://ui.example.com,http://192.168.1.20:3000

# ── Account auth source ──
# Default (no env at all): every ./data/accounts/*.json is loaded as a separate
# account. Put the pool there and plain `npm start` is enough.
# DEEPSEEK_AUTH_PATH overrides the pool with a single file (fresh checkouts).
DEEPSEEK_AUTH_PATH=./deepseek-auth.json
# DEEPSEEK_AUTH_DIR=./data/accounts

# ── Account pool ──
# Cooldown in milliseconds applied to an account after HTTP 401/403/429
# (default: 600000 = 10 minutes).
DEEPSEEK_ACCOUNT_COOLDOWN_MS=600000
# Minimum pause between logical upstream requests on the same account
# (PoW + session create + completion count as one). Reduces 429s from
# bursts (default: 5000 = 5 seconds; 0 disables pacing).
DEEPSEEK_MIN_REQUEST_INTERVAL_MS=5000
# Extra random pause (0..this ms) added on top of the interval so several
# agents never hit DeepSeek in lockstep (default: 2000; 0 disables).
DEEPSEEK_REQUEST_JITTER_MS=2000
# Gap between the individual upstream calls of one logical turn (PoW challenge,
# chat_session/create, completion) (default: 700; 0 disables).
DEEPSEEK_UPSTREAM_CALL_GAP_MS=700
# Base cooldown when DeepSeek reports "sending too often" inside the response
# stream instead of a 429. Doubles per repeat, capped by the account cooldown
# (default: 300000 = 5 min; this is an account-level throttle, so retrying
# within a minute only extends the block). The chat is preserved and the client
# gets 429 + Retry-After.
DEEPSEEK_RATE_LIMIT_COOLDOWN_MS=300000
# When the sticky account of a live session is cooling down, wait up to this
# many ms for it before answering 429 (session is never reset by a cooldown).
# Longer cooldowns answer 429 + Retry-After immediately (default: 60000).
DEEPSEEK_STICKY_WAIT_MS=60000

# ── Diagnostics ──
# Log the upstream JSON-patch paths and dump every raw SSE stream to
# $TMPDIR/deepseek_stream_*.jsonl. Use it to inspect what DeepSeek actually
# reports (token counters included) without touching the hot path otherwise.
# DEEPSEEK_DEBUG_STREAM=1
# Log which session/identity headers a client actually sends, so session
# isolation can be keyed on a real header instead of guessing.
# DEEPSEEK_DEBUG_SESSION=1
# Header carrying the conversation id (default x-agent-session).
# DEEPSEEK_AGENT_HEADER=x-agent-session
# Pin every request to one agent, ignoring all other identity sources.
# DEEPSEEK_AGENT_ID=my-agent
# Derive the key from the opening user message when the client sends no id.
# This is what keeps each opencode chat in its own DeepSeek chat. Set to 0 to
# fall back to the peer address (every local chat shares one conversation).
# DEEPSEEK_AGENT_FINGERPRINT=1

# ── Long agent sessions ──
# Maximum characters sent to DeepSeek Web after compacting old context.
# Lower this if the Web endpoint reports that the content is too long.
DEEPSEEK_MAX_PROMPT_CHARS=80000
# A brand-new chat sends the whole client transcript in one first message, which
# is the payload DeepSeek most often answers with an abuse notice. New sessions
# therefore use their own, smaller budget (default: 24000).
DEEPSEEK_FRESH_SESSION_PROMPT_CHARS=24000
# Fresh-session retries for an empty/context-too-long response (default: 2).
# The first retry reuses the live chat; only a second empty response
# recreates the remote session.
DEEPSEEK_MAX_RETRIES=2
# Auto-reset the remote chat after this many messages (default: 100).
DEEPSEEK_MAX_MESSAGE_DEPTH=100
# Auto-reset the remote chat after this age in ms (default: 6 hours).
# DeepSeek Web may drop sessions earlier; recovery history covers that.
DEEPSEEK_SESSION_TTL_MS=21600000
# Recovery buffer replayed only when a remote chat is missing. The remote
# session holds the real context, so keep this small (default: 3 exchanges /
# 2000 chars). An agent can re-read what it needs through tools.
DEEPSEEK_MAX_HISTORY_LENGTH=3
DEEPSEEK_MAX_HISTORY_CHARS=2000
# Remote chat ids are kept in ./data/sessions.json (mode 0600) so a restarted
# proxy resumes the same DeepSeek conversation instead of rebuilding one.
# Set DEEPSEEK_PERSIST_SESSIONS=0 to keep sessions in RAM only.
# DEEPSEEK_SESSIONS_FILE=./data/sessions.json
# Network timeout per DeepSeek call (default: 180000 = 3 minutes) and the
# wall-clock budget for one inbound request including retries (default: 300000
# = 5 minutes). A timeout no longer resets the remote chat.
DEEPSEEK_FETCH_TIMEOUT_MS=180000
DEEPSEEK_REQUEST_DEADLINE_MS=300000

# ── Startup (deploy / CI) ──
# Set either to 1/true to start the proxy immediately and skip the menu.
NON_INTERACTIVE=0
SKIP_ACCOUNT_MENU=0

# ── Chrome auth helper (scripts/deepseek_chrome_auth.js) ──
# Path to a Chrome / Chrome-for-Testing binary (auto-detected when empty).
CHROME_PATH=
# Remote-debugging port for the auth browser (auto when empty).
DEEPSEEK_CHROME_PORT=
# Chrome profile directory (defaults to a temporary profile).
DEEPSEEK_CHROME_PROFILE=
# Keep the Chrome profile between runs (1/true).
DEEPSEEK_KEEP_CHROME_PROFILE=0
# Reuse an already-running Chrome instance (1/true).
DEEPSEEK_REUSE_CHROME=0

# ── Misc ──
# Pre-set a token for non-interactive auth import.
# DEEPSEEK_TOKEN=
# Run scripts/doctor.js without network checks (1/true).
# DOCTOR_OFFLINE=0
